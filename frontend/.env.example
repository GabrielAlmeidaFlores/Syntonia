# ─── Syntonia Frontend — Environment Variables ──────────────────────────────
#
# Copy this file to .env.local for local development.
# All variables must also be set in Amplify Console for staging and production.
# See src/lib/env.ts for the typed exports used throughout the codebase.
#
# ── API ──────────────────────────────────────────────────────────────────────

# Base URL of the API Gateway REST endpoint.
# Leave empty in development — MSW intercepts relative paths.
# Production: https://xxxxxxxxxx.execute-api.sa-east-1.amazonaws.com/prod
VITE_API_URL=

# ── AWS Cognito ───────────────────────────────────────────────────────────────

# Cognito User Pool ID (sa-east-1_XXXXXXXXX)
VITE_COGNITO_USER_POOL_ID=

# Cognito App Client ID (no client secret — SPA)
VITE_COGNITO_CLIENT_ID=

# AWS region where the backend is deployed
VITE_AWS_REGION=sa-east-1
