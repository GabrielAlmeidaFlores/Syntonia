# For local development with serverless-offline only.
# In production, values come from serverless.yml environment + SSM Parameter Store.
GEMINI_API_KEY=AIzaSy...
FEED_TABLE=SintoniaFeed-dev
REQUESTS_TABLE=SintoniaRequests-dev
USERS_TABLE=SintoniaUsers-dev
RATE_LIMIT_TABLE=SintoniaRateLimit-dev
LEGAL_TABLE=SintoniaLegal-dev
GENERATION_QUEUE_URL=https://sqs.sa-east-1.amazonaws.com/123456789012/syntonia-generation-dev
STAGE=dev

# AWS region — defaults to sa-east-1 (São Paulo) if not set
AWS_REGION=sa-east-1

# Log level: DEBUG | INFO | WARN | ERROR
# Use DEBUG locally for verbose output; INFO is the default in production
LOG_LEVEL=DEBUG

# CORS: '*' allows any origin (default — good for development and multi-client APIs)
# To restrict, use a comma-separated list:
# CORS_ORIGINS=https://syntonia.app,https://dev.syntonia.app,http://localhost:5173
CORS_ORIGINS=*
